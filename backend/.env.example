# Pick one: claude | gemini | ollama | demo. Leave empty to use whichever key is set (or demo mode).
AI_PROVIDER=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

OLLAMA_MODEL=gemma3:4b
OLLAMA_HOST=http://localhost:11434

# 1 = FastAPI also serves the built React app (single-server deploy)
SERVE_FRONTEND=
# Comma-separated list, e.g. http://localhost:5173
CORS_ORIGINS=
